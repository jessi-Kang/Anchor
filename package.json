{
  "name": "anchor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate.ts --status",
    "backup:snapshot": "tsx scripts/backup/neon-snapshot.ts",
    "vercel-build": "tsx scripts/backup/neon-snapshot.ts --pre-deploy && next build",
    "design:tokens": "tsx scripts/design/tokens-to-css.ts",
    "design:check": "tsx scripts/design/check-screen.ts",
    "design:lint": "tsx scripts/design/lint-screens.ts",
    "design:diff": "tsx scripts/design/diff-screens.ts",
    "design:fold": "tsx scripts/design/fold-screens.ts",
    "design:edge": "tsx scripts/design/edge-screens.ts",
    "db:seed": "tsx scripts/seed.ts",
    "backup:restore": "tsx scripts/backup/restore-json.ts",
    "kanji:build": "tsx scripts/kanji/build-kanjidic.ts",
    "pitch:baseline": "tsx scripts/pitch/clone-baseline.ts",
    "docs:names": "tsx scripts/docs/name-check.ts",
    "measure": "tsx scripts/measure.ts",
    "measure:drive": "tsx scripts/measure-drive.ts",
    "measure:fixture": "tsx scripts/measure-fixture.ts",
    "seed:parts-sql": "tsx scripts/seed-parts-sql.ts",
    "fallbacks": "tsx scripts/fallbacks.ts",
    "test:db": "tsx scripts/db-provenance.ts && tsx --test scripts/test/*.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test:db",
    "push": "bash scripts/push.sh",
    "seed:sql": "tsx scripts/seed-sql.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.5",
    "pg": "^8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/pngjs": "^6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pixelmatch": "^7",
    "playwright-core": "^1",
    "pngjs": "^7",
    "tsx": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
