# ── Neon Postgres ─────────────────────────────────────────────────────────────
# 앱 런타임이 쓰는 연결. 반드시 RLS를 우회하지 못하는 `anchor_app` 역할이어야 한다.
# (Neon 콘솔에서 만든 역할은 neon_superuser 멤버라 BYPASSRLS가 있다. 마이그레이션이 SQL로 만든다.)
DATABASE_URL=postgresql://anchor_app:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 마이그레이션·백업 전용 연결 (테이블 소유자 역할, 예: neondb_owner). 앱 코드에서는 절대 쓰지 않는다.
DATABASE_URL_ADMIN=postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# 0001 마이그레이션이 anchor_app 역할을 만들 때 쓰는 비밀번호 (DATABASE_URL의 비밀번호와 같아야 한다)
ANCHOR_APP_PASSWORD=

# ── Neon Auth (Google OAuth) ──────────────────────────────────────────────────
# Neon 콘솔 → 프로젝트 → 브랜치 → Auth → Configuration 의 Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ── 백업 (scripts/backup, .github/workflows/backup.yml) ───────────────────────
# 배포 전 스냅샷: Neon API 키 + 프로젝트/브랜치 ID. 없으면 스냅샷 단계를 건너뛴다(프리뷰 배포용).
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# 매일 pg_dump를 올릴 별도 S3 호환 스토리지 (GitHub Actions secrets로 넣는다)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=35

# ── 외부 API (이후 단계) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_JESSI=pwjMkbtUbj1hBa0RkN5N
