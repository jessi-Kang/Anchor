{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm vercel-build",
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "17 18 * * *"
    }
  ]
}
